[Unit]
Description=Sistema de orçamentos da Panificadora Dreon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orcamentos-dreon
Group=www-data
WorkingDirectory=/opt/orcamentos-dreon
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATABASE_PATH=/var/lib/orcamentos-dreon/orcamentos.sqlite
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env pnpm start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/orcamentos-dreon /opt/orcamentos-dreon/.next

[Install]
WantedBy=multi-user.target
